  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "playwright-core": "1.61.1",
    "prettier": "3.9.10",
    "axe-core": "4.14.0"
  }
}
